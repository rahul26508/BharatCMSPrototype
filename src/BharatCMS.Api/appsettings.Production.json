{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "${BHARAT_DB_CONNECTION}"
  },
  "Jwt": {
    "Key": "${BHARAT_JWT_KEY}",
    "Issuer": "BharatCMS",
    "Audience": "BharatCMS.Api"
  },
  "Bhashini": {
    "ApiKey": "${BHASHINI_API_KEY}"
  },
  "AllowedHosts": "*"
}